# Database (Supabase Postgres)
# Local Postgres, or your Supabase connection string (Project Settings > Database > Connection string > Session pooler, port 5432)
DATABASE_URL="postgresql://user:password@localhost:5432/motionmagic"

# Secrets (generate with: openssl rand -hex 32)
SESSION_SECRET="change-me"
DOWNLOAD_SECRET="change-me"

# Storage: "local" for development, "r2" later (Cloudflare R2)
# "local" for development, "supabase" for production on Supabase Free (see README: Supabase setup)
STORAGE_DRIVER="local"
SUPABASE_URL=""                      # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=""         # SERVER ONLY. Never expose it to the browser or commit it.
SUPABASE_BUCKET="motionmagic"        # a PRIVATE bucket
# Personalized-only mode: only birthday templates + a name (no uploads, no free-text prompts). Set "false" to re-open everything.
PERSONALIZED_ONLY="true"
LOCAL_STORAGE_DIR="./.storage"

# AI provider. AI_MODE=mock runs the whole pipeline with zero AI cost.
AI_MODE="mock"
FAL_KEY=""
FAL_MOTION_MODEL="fal-ai/kling-video/v1/standard/image-to-video"
FAL_EDIT_MODEL="fal-ai/flux/dev/image-to-image"

# Budget controls (USD)
AI_MONTHLY_BUDGET_USD="25"
AI_KILL_SWITCH="false"
AI_MAX_RETRIES="1"
MAX_GENERATIONS_PER_GUEST_PER_DAY="10"

# --- Phase 5: payments (Pakistan, PKR) ---
# "mock" = instant fake payment (dev) | "easypaisa-sim" = sandbox simulator page | "easypaisa" = real gateway
PAYMENT_PROVIDER="mock"
# Payment switch for personalized GIFs. "true" = customer pays with Easypaisa before downloading.
# "false" = free: Download works directly, no payment screen. (Server-side: it cannot be bypassed from the browser.)
PAYMENT_REQUIRED="true"
# Accounts. "true" = the customer signs up / logs in (email + password, or Google) when pressing Download.
REQUIRE_LOGIN="true"
SESSION_DAYS="30"
ACCOUNT_RETENTION_DAYS="365"
# Optional "Continue with Google". Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web).
# Authorized redirect URI to add there:  <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APP_URL="http://localhost:3000"          # public address; the gateway sends customers back here
NEXT_PUBLIC_USD_TO_PKR="280"              # catalog prices are in USD, customers pay rupees. Rebuild after changing.
PAYMENT_PENDING_MINUTES="45"
ADMIN_TOKEN=""                            # long random string; opens /admin (refunds + profit report). Empty = admin off
PAYMENT_FEE_PERCENT="0"                   # for the profit report only; set from your Easypaisa agreement
# Easypaisa merchant credentials (from your onboarding pack; see src/services/payment/easypaisa.ts)
EASYPAISA_MODE="sandbox"                  # "production" when live
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""                     # exactly 16 characters
EASYPAISA_USERNAME=""
EASYPAISA_PASSWORD=""
EASYPAISA_ACCOUNT_NUM=""

# Files
MAX_UPLOAD_MB="10"
RETENTION_HOURS="24"

# --- Phase 3: free-tier AI keys (server-side only, never commit .env) ---
GEMINI_API_KEY=""
GEMINI_TEXT_MODEL="gemini-2.5-flash"      # use the exact model id from Google AI Studio
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
GEMINI_IMAGE_ENABLED="false"              # image EDITING is reported paid-only: keep false on a free key
GROQ_API_KEY=""
GROQ_TEXT_MODEL="llama-3.3-70b-versatile"
GROQ_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"
AI_TEXT_ORDER="groq,gemini"               # which to try first; the other is the fallback

# Daily caps that protect your free quotas
GEMINI_TEXT_DAILY_LIMIT="150"
GEMINI_IMAGE_DAILY_LIMIT="40"
GROQ_DAILY_LIMIT="400"
MAX_AI_GENERATIONS_PER_GUEST_PER_DAY="5"
MAX_DESIGNS_PER_GENERATION="3"

# Free tier bills $0; notional prices record what paid usage WOULD cost (verify before relying on them)
GEMINI_FREE_TIER="true"
GROQ_FREE_TIER="true"
